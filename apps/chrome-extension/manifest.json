{
  "manifest_version": 3,
  "name": "Property WhatsApp AI Automator",
  "version": "0.1.0",
  "description": "Browser-side integration for the WhatsApp AI automation backend.",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://127.0.0.1:3000/*",
    "ws://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Property WhatsApp AI",
    "default_popup": "popup.html"
  }
}
