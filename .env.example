# ==============================================================================
# Property Sales WhatsApp AI Automation - Environment Configuration
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
# Local Docker or native: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_ai?schema=public
POSTGRES_MAX_CONNECTIONS=20

# Redis Cache & Queues
REDIS_URL=redis://localhost:6379
REDIS_MAX_MEMORY=256mb

# Ollama Local AI Engine
# Configurable model - do not hardcode model name in codebase
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=15000

# Authentication & Security
# Min 32 characters for JWT secret in production
JWT_SECRET=dev-jwt-super-secret-key-32-characters-long!
JWT_EXPIRES_IN=7d
# Dedicated key for Chrome Extension authentication (never expose JWT secrets to extension)
EXTENSION_API_KEY=ext_dev_secret_key_12345
ADMIN_API_KEY=admin_dev_secret_key_67890

# Safeguards & Automation Rules
# Non-negotiable safety: AUTO_SEND must default to false in development
AUTO_SEND=false
AI_CONFIDENCE_THRESHOLD=0.85

# Cross-Origin Resource Sharing
CORS_ORIGIN=http://localhost:5173,chrome-extension://*
